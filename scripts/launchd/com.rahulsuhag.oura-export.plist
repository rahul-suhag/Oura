<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd agent: run `oura-export run` every 3 hours.
  (Use either this OR the Windows task, not both, or you'll get two requests a day.)

  Install:
    1. Replace /CHANGE/ME/Oura with the absolute path of your clone (twice below).
    2. cp scripts/launchd/com.rahulsuhag.oura-export.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.rahulsuhag.oura-export.plist
    4. launchctl list | grep oura-export
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rahulsuhag.oura-export</string>

    <key>ProgramArguments</key>
    <array>
        <string>/CHANGE/ME/Oura/venv/bin/python</string>
        <string>-m</string>
        <string>oura_export</string>
        <string>run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/CHANGE/ME/Oura</string>

    <!-- Every 3 hours; also once when loaded or after login. -->
    <key>StartInterval</key>
    <integer>10800</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/oura-export.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/oura-export.err.log</string>
</dict>
</plist>
